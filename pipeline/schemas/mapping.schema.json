{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mapping.schema.json",
  "title": "Externally supplied reviewed source-to-outline mapping input",
  "description": "The pipeline validates this artifact but never creates or repairs it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mapping_version",
    "source_manifest_hash",
    "outline_raw_sha256",
    "outline_normalized_sha256",
    "outline_review_hash",
    "review_status",
    "entries"
  ],
  "properties": {
    "mapping_version": {"const": "1.0"},
    "mapping_schema_version": {"const": "1.6.0"},
    "pipeline_version": {"type": "string", "minLength": 1},
    "source_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "block_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outline_raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outline_normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outline_review_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_status": {"const": "REVIEWED"},
    "mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "role", "placement"],
        "properties": {
          "block_id": {"type": "string", "pattern": "^B[0-9]{4,}$"},
          "target_id": {"type": ["string", "null"], "pattern": "^(?:BOOK|V[0-9]{2}(?:-P[0-9]{2})?(?:-C[0-9]{2})?(?:-S[0-9]{2})?|O[0-9]{4,})$"},
          "placement": {"type": "integer", "minimum": 1},
          "role": {"enum": ["PRIMARY", "SECONDARY", "REFERENCE", "DUPLICATE", "EXPLICITLY_UNMAPPED"]}
        }
      }
    },
    "unmapped_block_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^B[0-9]{4,}$"}
    },
    "duplicate_relations": {"type": "array"}
  }
}
